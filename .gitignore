# Proprietary and local-only inputs
/nvngx_dlssnr.dll
/renodx-dlss5-1.addon64
/runtime_local/
/runtime/
/third_party_local/
/reference_local/

# Build outputs and local presets
/out/
/build/
/.vs/
/vcpkg_installed/
CMakeUserPresets.json

# Diagnostics and captures
/captures/
/logs/
*.pdb
*.ilk
*.dmp
*.etl

# Unattended loop local control and scratch
/loop/STOP
/loop/tmp/
/loop/local/

# PushFPS: never commit credentials or signing material
.env
.env.*
*.pfx
*.p12
*.pem
*.key
*.snk
secrets/
licenses/sdk/
# User-authorized runtime music is distributed only in binary packages.
startup-music.mp3
BGM.MP3

# Python byte code (written when a script imports another; never part of the source)
__pycache__/
*.pyc
